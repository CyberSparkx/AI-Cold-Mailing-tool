# ── App Configuration ─────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ENV=development
LOG_LEVEL=info

# ── Auth.js (NextAuth v5) ────────────────────────────────────
AUTH_SECRET=your_auth_secret_minimum_32_characters_long_base64
AUTH_TRUST_HOST=true

# ── Google OAuth & APIs ──────────────────────────────────────
# Create in Google Cloud Console with Gmail, Sheets, Drive API enabled
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/google/callback
GOOGLE_PICKER_API_KEY=your_browser_restricted_picker_key

# ── Encryption & Signatures (32 random bytes, base64) ────────
TOKEN_ENCRYPTION_KEY=your_token_encryption_key_32_bytes_base64==
TOKEN_ENCRYPTION_KEY_VERSION=1
UNSUBSCRIBE_SIGNING_KEY=your_unsubscribe_hmac_signing_key_32_bytes==
CRON_SECRET=your_secret_for_scheduled_tasks

# ── Database (MongoDB Atlas Replica Set) ─────────────────────
DATABASE_URL=mongodb+srv://username:password@cluster.mongodb.net/cold_mailing?retryWrites=true&w=majority

# ── Redis / Queue (BullMQ) ───────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=app:dev:
QUEUE_DRIVER=bullmq

# ── AI Integration (Google Gemini + LangChain) ───────────────
GEMINI_API_KEY=your_gemini_api_key
AI_MODEL_CLASSIFY=gemini-2.0-flash-lite
AI_MODEL_PERSONALIZE=gemini-2.0-flash
AI_MODEL_ESCALATE=gemini-2.0-flash
AI_MONTHLY_TOKEN_CAP=1000000
AI_BATCH_SIZE=15
AI_MAX_INPUT_CHARS=1500
FEATURE_AI_PERSONALIZATION=true
FEATURE_AI_CLASSIFICATION=true

# ── Lead Sources ─────────────────────────────────────────────
GOOGLE_PLACES_API_KEY=your_places_api_key
PLACES_DAILY_REQUEST_BUDGET=200
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
SEARCH_API_KEY=your_search_api_key
LEADS_MAX_RESULTS_PER_SEARCH=100
SITE_FETCH_USER_AGENT=OutreachDashboard/1.0 (+https://narenroy.in/)

# ── Vector / Pinecone (Optional) ─────────────────────────────
FEATURE_VECTOR=false
PINECONE_API_KEY=
PINECONE_INDEX=
PINECONE_NAMESPACE_PREFIX=

# ── Sending Safety & Limits ──────────────────────────────────
HARD_DAILY_CAP=100
DEFAULT_DAILY_LIMIT=25
WARMUP_ENABLED=true
SEND_MIN_DELAY_SEC=45
SEND_MAX_DELAY_SEC=150
BREAKER_FAILURE_THRESHOLD=0.05
INBOX_MIN_SYNC_INTERVAL_SEC=300
INBOX_RETENTION_DAYS=90

# ── Monitoring (Optional) ────────────────────────────────────
SENTRY_DSN=
