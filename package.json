{
  "name": "ai-cold-mailing-tool",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "node --env-file=.env.local node_modules/prisma/build/index.js generate",
    "prisma:push": "node --env-file=.env.local node_modules/prisma/build/index.js db push",
    "worker:dev": "node --env-file=.env.local node_modules/tsx/dist/cli.mjs watch src/worker/index.ts",
    "worker:build": "tsup src/worker/index.ts --out-dir dist/worker --format cjs --no-splitting",
    "test": "vitest run",
    "prepare": "husky"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.4",
    "@gsap/react": "^2.1.1",
    "@hookform/resolvers": "^3.9.1",
    "@langchain/core": "^0.3.18",
    "@langchain/google-genai": "^0.1.2",
    "@prisma/client": "^5.22.0",
    "@tanstack/react-query": "^5.60.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "googleapis": "^144.0.0",
    "gsap": "^3.12.5",
    "ioredis": "^5.4.1",
    "lenis": "^1.1.18",
    "lucide-react": "^0.460.0",
    "next": "^14.2.24",
    "next-auth": "^4.24.10",
    "next-themes": "^0.4.3",
    "pino": "^9.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.2",
    "server-only": "^0.0.1",
    "sonner": "^1.7.0",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "bullmq": "^5.29.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.24",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "pino-pretty": "^13.0.0",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.15",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
